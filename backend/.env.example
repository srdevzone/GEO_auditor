# Copy to backend/.env and fill in the keys you have. Every line is optional.
# At least ONE provider must be configured. OPENCODE is recommended (cheap, and
# the key can be picked up automatically from ~/.local/share/opencode/auth.json).

# --- OpenAI (web search available) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6

# --- Groq (no web search -> labelled search proxy) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenCode (OpenCode Go / Zen key from https://opencode.ai/auth) ---
# OPENCODE_API_KEY=oc_...
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=deepseek-v4-flash
# (GPT/Grok model ids get live web search via /responses, e.g. OPENCODE_MODEL=gpt-5.6-luna)

# --- Local models (no web search -> labelled search proxy) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=

# --- Audit behaviour ---
# GEO_MAX_PAGES=15
# GEO_NUM_QUERIES=7
# GEO_WEB_SEARCH=1
# GEO_TIMEOUT=20
# GEO_LLM_TIMEOUT=120
